pkgname=ports-box
pkgver=0.6.0
pkgrel=0
pkgdesc="Linux TCP/UDP port forwarder with per-user traffic quotas"
url="https://github.com/Yuu518/ports-box"
arch="x86_64 aarch64"
license="MIT"
makedepends="
	cargo
	rust
	build-base
	"
# rusqlite is built bundled and compiles its own sqlite3.c, so a C toolchain
# is part of the build.
subpackages="$pkgname-openrc"
source="ports-box-$pkgver.tar.gz::https://github.com/Yuu518/ports-box/archive/refs/tags/$pkgver.tar.gz
	ports-box.initd
	"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	binary="$builddir/target/release/ports-box"
	test "$("$binary" --version)" = "ports-box $pkgver"
	install -Dm755 "$binary" "$pkgdir/usr/bin/ports-box"
	install -Dm644 "$builddir/config.example.json" \
		"$pkgdir/usr/share/doc/ports-box/config.example.json"
	install -Dm755 "$srcdir/ports-box.initd" \
		"$pkgdir/etc/init.d/ports-box"
	install -d "$pkgdir/var/lib/ports-box"
}

sha512sums="
98b1af5580f116dab38ca91290d43db7346e156095ebd47d9a2edaa50869804777a2b27fd4583786766c2b640a55357c7f144881a310978102427177167b3385  ports-box-0.6.0.tar.gz
5cd1421a51c641106c4c7362a7f3fdf5d45f8556811b29085b35af2ef561ba5f44fae8074f9533927d78cc4f19bb5d684f47dc5486775826947d3081a34be665  ports-box.initd
"
