pkgname=ports-box
pkgver=0.1.3
pkgrel=0
pkgdesc="Linux TCP/UDP port forwarder with per-user traffic quotas"
url="https://github.com/Yuu518/ports-box"
arch="x86_64 aarch64"
license="MIT"
makedepends="
	cargo
	rust
	build-base
	"
# rusqlite is built bundled and compiles its own sqlite3.c, so a C toolchain
# is part of the build.
source="ports-box-$pkgver.tar.gz::https://github.com/Yuu518/ports-box/archive/refs/tags/v$pkgver.tar.gz"

build() {
	cargo build --release --locked
}

check() {
	cargo test --locked
}

package() {
	binary="$builddir/target/release/ports-box"
	test "$("$binary" --version)" = "ports-box $pkgver"
	install -Dm755 "$binary" "$pkgdir/usr/bin/ports-box"
	install -Dm644 "$builddir/config.example.json" \
		"$pkgdir/usr/share/doc/ports-box/config.example.json"
}

sha512sums="
aa560f5bbb9ceb12edb361c8b6d221acd75a62dde5c0259215c41de7285bf4fb594c5eb413266ea4b649572ccdcac756e2b90067df0fd3d2089ac2ae39450974  ports-box-0.1.3.tar.gz
"
