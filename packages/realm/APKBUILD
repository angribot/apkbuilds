pkgname=realm
pkgver=2.9.6
pkgrel=0
pkgdesc="A simple, high performance relay server written in Rust"
url="https://github.com/zhboner/realm"
arch="x86_64 aarch64"
license="MIT"
options="!check !strip"
subpackages="$pkgname-openrc"

case "$CARCH" in
x86_64)
	_sha512="d4e7861545043afc2095ab031854441a63fd697de9bbeabcd8af5572af10fa261427b3372e3c26a7e73e4540c0bb9548cea32d11276594795c3de628788af7da"
	;;
aarch64)
	_sha512="960f8ff8cc5b6e2cc48f0fa1900c8779eb42ad3d277cdb77851dac5679a811dcbef298f1350b8934481446d2f388548817bec21319549d4bf151104d4930fa10"
	;;
esac
# Only the architectures above are supported; a stale _sha512 would
# produce an empty checksum line in sha512sums.

source="realm-$pkgver-$CARCH.tar.gz::https://github.com/zhboner/realm/releases/download/v$pkgver/realm-$CARCH-unknown-linux-musl.tar.gz
	realm.initd
	"

package() {
	install -Dm755 "$srcdir/realm" "$pkgdir/usr/bin/realm"
	install -Dm755 "$srcdir/realm.initd" "$pkgdir/etc/init.d/realm"
	install -d "$pkgdir/etc/realm"
}

sha512sums="
$_sha512  realm-$pkgver-$CARCH.tar.gz
6c29bd6bb61bfb4147acd2cd967975151326fc53ace8770b640ce5be0503d95f5801e5000e6b0d8d4a10d86bc75f206aebc616b807843a38b267dd4d68a1cc56  realm.initd
"
