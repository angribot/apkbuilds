pkgname=orbien
pkgver=3.5.0
pkgrel=0
pkgdesc="Lightweight high-performance intranet tunneling client"
url="https://github.com/orbien-org/orbien"
arch="x86_64 aarch64"
license="Apache-2.0"
depends="ca-certificates"
# ring (via rustls) compiles C and assembly in its build script.
makedepends="
	cargo
	rust
	build-base
	nodejs
	npm
	"
subpackages="$pkgname-server:server $pkgname-server-openrc:server_openrc"
# Cargo's release profile strips the binaries itself.
options="!strip"
source="orbien-$pkgver.tar.gz::https://github.com/orbien-org/orbien/archive/refs/tags/v$pkgver.tar.gz
	orbien-server.initd
	"

prepare() {
	default_prepare
	# Use crates.io instead of upstream's rsproxy source replacement.
	rm .cargo/config.toml
	cargo fetch --target="$CTARGET" --locked
	# Install exactly the dashboard dependency graph recorded by upstream.
	(
		cd server-ui
		npm ci
	)
}

build() {
	# The server embeds server/assets at compile time.
	(
		cd server-ui
		npm run build
	)
	cargo build --release --frozen --package orbien-client --bin orbien
	cargo build --release --frozen --package orbien-server --bin orbien-server
}

check() {
	cargo test --frozen \
		--package orbien-core \
		--package orbien-client \
		--package orbien-server
}

package() {
	install -Dm755 "$builddir/target/release/orbien" "$pkgdir/usr/bin/orbien"
	install -Dm644 "$builddir/conf/orbien.toml" \
		"$pkgdir/usr/share/doc/orbien/orbien.toml"
	install -Dm644 "$builddir/conf/orbien-full.toml" \
		"$pkgdir/usr/share/doc/orbien/orbien-full.toml"
}

server() {
	pkgdesc="Lightweight high-performance intranet tunneling server"
	depends="ca-certificates"

	install -Dm755 "$builddir/target/release/orbien-server" \
		"$subpkgdir/usr/bin/orbien-server"
	install -Dm644 "$builddir/conf/orbien-server.toml" \
		"$subpkgdir/usr/share/doc/orbien-server/orbien-server.toml"
	install -Dm644 "$builddir/conf/orbien-server-full.toml" \
		"$subpkgdir/usr/share/doc/orbien-server/orbien-server-full.toml"
}

server_openrc() {
	pkgdesc="OpenRC service for Orbien server"
	depends="openrc $pkgname-server=$pkgver-r$pkgrel"
	install_if="$pkgname-server=$pkgver-r$pkgrel openrc"

	install -Dm755 "$srcdir/orbien-server.initd" \
		"$subpkgdir/etc/init.d/orbien-server"
}

sha512sums="
4e5451ff6a6a587682718c48be83170cdac6b2c36476f5fd617834b395123b716a346f62dcee6d31f39eabf1c0ffbd28540bfdc99fa035bd0d385319a8d2f253  orbien-3.5.0.tar.gz
8de7dbac30ee25a7ac4b9c33dda44a71d5832982ae9cf2dabf88ea5d245273633c52df24e3c9586f5c28fe6e5147c7dd06cccb15652ab811b5d7ceb7a8e0cfa3  orbien-server.initd
"
