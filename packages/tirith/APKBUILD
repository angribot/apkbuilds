bec8f6995fa3bc525f5aa0a2d0d83010592c39f70b9965d4cefc0e848ec4c378900811a6b20b27a9c8de97d8e4c2d282764187271c367ae15925e1d7596673a8  0001-add-apk-install-method.patch
"
