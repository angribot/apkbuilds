pkgname=zerostack
pkgver=1.8.4
pkgrel=0
pkgdesc="Minimalistic coding agent written in Rust"
url="https://github.com/gi-dellav/zerostack"
arch="x86_64 aarch64"
license="GPL-3.0-only"
# zerostack shells out to bash for tool execution.
depends="bash"
# ring (via rustls) compiles C/asm in its build script.
makedepends="
	cargo
	rust
	build-base
	"
# detect_git_branch_in_repo_returns_nonempty expects a git checkout,
# but abuild extracts a source tarball. The staged APK is tested with
# its repository read-only.
options="!check !strip"
source="zerostack-$pkgver.tar.gz::https://github.com/gi-dellav/zerostack/archive/refs/tags/v$pkgver.tar.gz"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET"
}

build() {
	cargo build --frozen --release
}

check() {
	cargo test --frozen
}

package() {
	binary="$builddir/target/release/zerostack"
	test "$("$binary" --version)" = "zerostack $pkgver"
	install -Dm755 "$binary" "$pkgdir/usr/bin/zerostack"
}

sha512sums="
9c8791b99fcca00a518bd69b678c3b174184edd940ac6cb95c38f816657b55c6abfe5597a8857156c048c7dfb931eb48681a1874b54ad71ff5d938ad7abc2e7d  zerostack-1.8.4.tar.gz
"
