# Synthetic package origin used only by the real-container integration test.
pkgname=apkbuilds-ci-probe
pkgver=2.0.0
pkgrel=0
pkgdesc="Compiled repository integration fixture"
url="https://example.invalid/apkbuilds-ci-probe"
arch="x86_64 aarch64"
license="MIT"
depends="$pkgname-data=$pkgver-r$pkgrel"
subpackages="$pkgname-data::noarch"
source="probe.c message.txt"
builddir="$srcdir"

build() {
	${CC:-cc} -Wall -Wextra -Werror -o probe probe.c
}

check() {
	test "$(./probe message.txt)" = "apkbuilds-ci-probe: split payload"
}

package() {
	install -Dm755 probe "$pkgdir/usr/bin/apkbuilds-ci-probe"
	install -Dm644 message.txt "$pkgdir/usr/share/apkbuilds-ci-probe/message.txt"
}

data() {
	pkgdesc="Data for the repository integration fixture"
	depends=""
	amove usr/share/apkbuilds-ci-probe
}

